{
  "name": "yunwu-desktop",
  "version": "0.1.0",
  "description": "云雾桌面客户端 - 本地运行 OpenClaw agent,像 WorkBuddy 一样操作本地文件",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "yunwu",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "prepare-kernel": "node scripts/prepare-kernel.mjs",
    "pack": "npm run build && npm run prepare-kernel && electron-builder",
    "pack:win": "npm run build && npm run prepare-kernel && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/ws": "^8.18.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "ai.yunwu.desktop",
    "productName": "Yunwu Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
