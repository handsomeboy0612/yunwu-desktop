# 仅忽略仓库根的依赖与构建输出;前导 "/" 确保不误伤
# resources/openclaw 下随包内置的 dist/ 与 node_modules(内核运行必需)。
/node_modules/
/out/
/dist/

# electron-builder 打包产物(体积巨大,含超 100MB 文件)
/release/

# WorkBuddy 分析残留
/.wb-analysis/
/wb_ls.txt

# 日志 / 系统文件 / 本地密钥
*.log
.DS_Store
/.env
/.env.local

# TypeScript 增量编译缓存
*.tsbuildinfo

# 工具与探针的本地残留
/.slidep/
/scripts/pc-out.txt
/空白幻灯片.pptx

# 真机验证的一次性脚本与产物:里面有测试站令牌、生成的图片、装机扫描留下的
# preset 目录,几十 MB 且只对当时那台机器有意义。复现方式写在
# docs/dsh-kernel-migration.md 里,脚本本身不入库。
.tmp-e2e/
.tmp-probe/
.tmp-wb3/
